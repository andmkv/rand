# Run `npm run setup` to create a private .env and SMTP password file. This file
# is documentation only; do not start the production Compose stack with it.
POSTGRES_PASSWORD=replace-with-setup-generated-random-value
DATABASE_URL=postgresql://randusr:replace-with-setup-generated-random-value@db:5432/randusr
ADMIN_BOOTSTRAP_EMAIL=owner@example.invalid
WEB_PORT=8080
# Host API defaults (for local development only):
API_PORT=3001
API_HOST=127.0.0.1
# Production identity and SMTP: configure your own host, verified admin email,
# sender and secret file. `npm run setup` writes these values with mode 0600.
NODE_ENV=production
APP_BASE_URL=https://usr.example.org
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=owner@example.org
SMTP_PASSWORD_FILE=./secrets/smtp_password
SMTP_FROM_EMAIL=noreply@example.org
SMTP_FROM_NAME=Randomize USR
MAIL_MODE=smtp
MAIL_DIRECTORY=/tmp/randusr-mail
VITE_SHOW_BRAND_FOOTER=true
# Leave policy versions unset until actual reviewed documents are provided.
TERMS_VERSION=
PRIVACY_VERSION=
# Reviewed, public HTTPS documents; configure each URL together with its version.
TERMS_URL=
PRIVACY_URL=
# Operator-controlled support contact (never defaults to the bootstrap admin).
SUPPORT_EMAIL=
REVISION_KEEP_COUNT=50
REVISION_KEEP_DAYS=30
MAX_SOURCE_CHARACTERS=100000
MAX_PROJECTS_PER_USER=1000

# Limits are validated at startup; see docs/SECURITY.md for defaults/ranges.
MAX_PROJECT_PAYLOAD_BYTES=524288
MAX_PUBLICATIONS_PER_15_MINUTES=20
MAX_AUTOSAVES_PER_MINUTE=120
# Compose trusts its one bundled Caddy hop. Keep the API private behind the web service.
TRUST_PROXY_HOPS=1

# Closed test by default; public=true requires reviewed policy URLs/versions + support.
PUBLIC_REGISTRATION_ENABLED=false
# Isolated, in-memory UAT demo sessions (login demo/demo or Try Demo).
# Set false to remove the demo login and all /api/v1/demo routes. See docs/DEMO.md.
DEMO_MODE_ENABLED=true
DEMO_IDLE_MINUTES=60
DEMO_ABSOLUTE_HOURS=24
DEMO_MAX_SESSIONS=50
DEMO_MAX_SESSIONS_PER_IP=10
DEMO_MAX_PROJECTS=10
DEMO_MAX_REVISIONS=20
DEMO_MAX_SESSION_BYTES=4194304
DEMO_MAX_STORE_BYTES=67108864
DEMO_LOGIN_PER_15_MINUTES=10
# Optional tab measurement: off until operator notice/consent rules are reviewed.
PRODUCT_ANALYTICS_ENABLED=false
PRODUCT_ANALYTICS_NOTICE_VERSION=
PRODUCT_ANALYTICS_NOTICE_URL=
