{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "../dist-server",
    "rootDir": "..",
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "./*.ts",
    "./db/**/*.ts",
    "../shared/**/*.ts"
  ],
  "exclude": [
    "tests"
  ]
}
