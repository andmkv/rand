{
  "name": "randomize-usr",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run && node --experimental-strip-types --test scripts/localization.test.mjs && node --test scripts/setup.test.mjs && npm run i18n:check",
    "test:e2e": "playwright test",
    "book:check": "vitest run tests/book.test.ts",
    "security:secrets": "node scripts/secrets-check.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "i18n:export": "node --experimental-strip-types scripts/i18n-export.mjs",
    "i18n:import": "node --experimental-strip-types scripts/i18n-import.mjs",
    "i18n:check": "node --experimental-strip-types scripts/i18n-check.mjs",
    "license:check": "node scripts/license-audit.mjs",
    "api:dev": "tsx watch server/index.ts",
    "setup": "node scripts/setup.mjs",
    "mail:test": "node --env-file=.env --import tsx server/smtp-test-cli.ts",
    "api:build": "tsc -p server/tsconfig.json && node -e \"require('node:fs').cpSync('server/migrations','dist-server/server/migrations',{recursive:true})\"",
    "api:start": "node dist-server/server/index.js",
    "api:test": "tsx --test --test-concurrency=1 server/tests/*.test.ts",
    "db:generate": "node scripts/db-generate-guard.mjs",
    "db:verify-schema": "node --import tsx --test server/tests/schema-drift.test.ts",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:seed": "tsx server/db/seed.ts",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json --noEmit",
    "account:invite": "tsx server/invite-cli.ts",
    "admin:recover": "tsx server/admin-recovery-cli.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@lezer/highlight": "^1.2.1",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
